# Gemini API (Cloud-Lauf, kostenlos: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic API (nur bei llm.provider: anthropic)
ANTHROPIC_API_KEY=

# E-Mail-Benachrichtigung (Standardkanal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional: Push über ntfy.sh (Kanal in config.yaml aktivieren)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# optional: Obsidian-Ordner für die Vault-Notizen (Standard ~/Obsidian/Deals)
DEALRADAR_VAULT_DIR=
