<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.dealradar.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT__/.venv/bin/python</string>
    <string>-m</string>
    <string>dealradar</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <!-- 07:30 Ortszeit des Macs (Zeitzone muss Europe/Berlin sein). Verpasste Läufe im Ruhezustand werden beim Aufwachen nachgeholt. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key><string>Europe/Berlin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/logs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
